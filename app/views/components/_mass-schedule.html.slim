section#schedule.mass-schedule.py-5 aria-labelledby="schedule-title"
  .container-fluid.px-5
    .row.align-items-center
      .col-12.col-lg-4.mb-3.mb-lg-0
        h2#schedule-title.mass-schedule__title.fw-bold.text-white.mb-1
          | Sunday Mass Schedule
        p.mass-schedule__subtitle.text-light.mb-2.small
          | Journey with us in Christ.
        a.mass-schedule__link.text-decoration-none.small href="#"
          | View Full Schedule →

      .col-12.col-lg-8
        .row.text-white
          .col-4.text-center.border-start.ps-3.mass-schedule__slot
            p.small.fw-bold.mb-1.mass-schedule__label
              | MORNING
            p.mb-0.mass-schedule__time
              | 7:00 – 8:00 AM
          .col-4.text-center.border-start.ps-3.mass-schedule__slot
            p.small.fw-bold.mb-1.mass-schedule__label
              | AFTERNOON
            p.mb-0.mass-schedule__time
              | 5:00 – 6:00 PM
          .col-4.text-center.border-start.ps-3.mass-schedule__slot
            p.small.fw-bold.mb-1.mass-schedule__label
              | EVENING
            p.mb-0.mass-schedule__time
              | 6:00 – 7:00 PM