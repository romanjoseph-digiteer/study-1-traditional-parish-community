section.hero.min-vh-100 aria-labelledby="hero-title"
  .container-fluid.p-0
    .row.g-0.min-vh-100
      .col-12.col-lg-8.d-flex.flex-column.p-4.p-lg-5
        nav.navbar.navbar-expand-lg.p-0 aria-label="Main navigation"
          a.navbar-brand.d-flex.align-items-center href="/"
            = image_tag "logo.webp", alt: "", width: "36", height: "36"
            span.ms-2.hero__brand-text Church Logo
          button.navbar-toggler type="button" data-bs-toggle="collapse" data-bs-target="#hero-navigation" aria-controls="hero-navigation" aria-expanded="false" aria-label="Toggle navigation"
            span.navbar-toggler-icon
          #hero-navigation.collapse.navbar-collapse
            ul.navbar-nav.gap-lg-3
              li.nav-item
                a.nav-link href="#about" About
              li.nav-item
                a.nav-link href="#schedule" Mass Schedule
              li.nav-item
                a.nav-link href="#ministries" Ministries
              li.nav-item
                a.nav-link href="#events" Events
              li.nav-item
                a.nav-link href="#news" News
              li.nav-item
                a.nav-link href="#contact" Contact

        .d-flex.flex-column.justify-content-center.flex-grow-1.py-5
          .row
            .col-12.col-xl-10
              p.hero__eyebrow Parish Name
              h1#hero-title.hero__title
                | Welcome Home to Our Parish Community
              p.hero__subtitle A place of faith, community, and service — journey with us in Christ.
              a.btn.hero__cta href="#schedule" View Mass Schedule

      .col-lg-4.d-none.d-lg-block.p-0
        .h-100.overflow-hidden
          = image_tag "hero-bg.webp", alt: "Heavens background for hero", class: "w-100 h-100 object-fit-cover d-block", loading: "eager", decoding: "async"
