section.hero.min-vh-100
  .container-fluid
    .row.align-items-center.min-vh-100
      .col-lg-8.ps-lg-5.py-5
        .row
          .col-12
            nav.navbar.navbar-expand-lg.p-0
              .container-fluid.p-0.d-flex.align-items-center
                a.navbar-brand.d-flex.align-items-center href="/"
                  = image_tag "logo.webp", alt: "Church Logo", width: "36", height: "36"
                  span.ms-2.hero__brand-text Church Logo

                ul.nav.ms-auto.d-none.d-lg-flex
                  li.nav-item
                    a.nav-link href="#about" About
                  li.nav-item
                    a.nav-link href="#schedule" Mass Schedule
                  li.nav-item
                    a.nav-link href="#ministries" Ministries
                  li.nav-item
                    a.nav-link href="#events" Events
                  li.nav-item
                    a.nav-link href="#news" News
                  li.nav-item
                    a.nav-link href="#contact" Contact

              / button.navbar-toggler.type-button.d-lg-none type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavHero" aria-controls="navbarNavHero" aria-expanded="false" aria-label="Toggle navigation"
              /   span.navbar-toggler-icon

              / #navbarNavHero.collapse.navbar-collapse.d-lg-none
              /   ul.nav.flex-column
              /     li.nav-item
              /       a.nav-link href="#about" About
              /     li.nav-item
              /       a.nav-link href="#schedule" Mass Schedule
              /     li.nav-item
              /       a.nav-link href="#ministries" Ministries
              /     li.nav-item
              /       a.nav-link href="#events" Events
              /     li.nav-item
              /       a.nav-link href="#news" News
              /     li.nav-item
              /       a.nav-link href="#contact" Contact

          .col-12
            .hero__body.py-5
              .row
                .col-12.col-lg-10
                  p.hero__eyebrow Parish Name
                  h1.hero__title Welcome Home to Our Parish Community
                  p.hero__subtitle A place of faith, community, and service — journey with us in Christ.
                  a.btn.btn-primary.hero__cta.mt-3 href="#schedule" View Mass Schedule

      .col-lg-4.d-none.d-lg-block.p-0
        .hero__right.h-100
          = image_tag "hero-bg.webp", alt: "Heavens background for hero", class: "w-100 h-100 object-fit-cover", loading: "eager", decoding: "async"